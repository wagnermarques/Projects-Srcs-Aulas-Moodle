  <question type="multichoice">
    <name>
      <text>Time Complexity of Binary Search</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[What is the worst-case time complexity of running a &lt;strong&gt;Binary Search&lt;/strong&gt; algorithm on a sorted array of \(n\) elements?]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[Binary search repeatedly divides the search interval in half, yielding logarithmic performance.]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[\(\mathcal{O}(\log n)\)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct! Halving the search space at each step gives logarithmic time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[\(\mathcal{O}(n)\)]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. \(\mathcal{O}(n)\) is the complexity of Linear Search.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[\(\mathcal{O}(n \log n)\)]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. \(\mathcal{O}(n \log n)\) is the typical complexity of efficient sorting algorithms like Merge Sort.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[\(\mathcal{O}(1)\)]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Constant time is achieved by direct array index lookup or hash tables.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="truefalse">
    <name>
      <text>P vs NP Problem Definition</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[The class **NP** consists of all decision problems that can be &lt;strong&gt;verified&lt;/strong&gt; in polynomial time by a deterministic Turing Machine.]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <answer fraction="100">
      <text>true</text>
      <feedback format="html">
        <text><![CDATA[Correct! NP stands for Nondeterministic Polynomial time, meaning solutions can be verified efficiently in polynomial time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>false</text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This statement is accurate according to computational complexity theory.]]></text>
      </feedback>
    </answer>
  </question>
