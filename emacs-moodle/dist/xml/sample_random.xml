  <question type="matching">
    <name>
      <text>Programming Paradigms and Languages</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Match each programming language to its primary paradigm:]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <shuffleanswers>true</shuffleanswers>
    <subquestion format="html">
      <text><![CDATA[Haskell]]></text>
      <answer>
        <text>Functional Programming</text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[Prolog]]></text>
      <answer>
        <text>Logic Programming</text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[Java]]></text>
      <answer>
        <text>Object-Oriented Programming</text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[C]]></text>
      <answer>
        <text>Imperative / Procedural Programming</text>
      </answer>
    </subquestion>
  </question>
  <question type="numerical">
    <name>
      <text>Speed of Light Constant</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[What is the speed of light in a vacuum in millions of meters per second (approx. \(299.79\))?]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <answer fraction="100">
      <text>299.79</text>
      <tolerance>5.0</tolerance>
      <feedback format="html">
        <text><![CDATA[Correct! The speed of light \(c \approx 299,792,458\text{ m/s}\).]]></text>
      </feedback>
    </answer>
  </question>
  <question type="truefalse">
    <name>
      <text>P vs NP Problem Definition</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[The class **NP** consists of all decision problems that can be &lt;strong&gt;verified&lt;/strong&gt; in polynomial time by a deterministic Turing Machine.]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <answer fraction="100">
      <text>true</text>
      <feedback format="html">
        <text><![CDATA[Correct! NP stands for Nondeterministic Polynomial time, meaning solutions can be verified efficiently in polynomial time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>false</text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This statement is accurate according to computational complexity theory.]]></text>
      </feedback>
    </answer>
  </question>
